{
  "crons": [
    {
      "path": "/api/daily-ceo-traffic-brief",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:lang(es|en|pt|zh|ja|ko)",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(es|en|pt|zh|ja|ko)/",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(es|en|pt|zh|ja|ko)/:path*",
      "destination": "/:path*"
    }
  ]
}
